# Supabase API Configuration
# Replace these values with your actual Supabase project credentials from https://app.supabase.com

# Public Supabase URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co

# Public Supabase Anon API Key (Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Server-side & Admin Desk bypass, keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Base URL (for local development or production domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend API Key for Magic Link Email Delivery (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
# Optional: Verified Custom Domain Sender (defaults to 'Instangalog <onboarding@resend.dev>')
# RESEND_FROM_EMAIL=Instangalog <auth@yourdomain.com>



# -----------------------------------------------------------------------------
# Cloudinary Direct Video & Image Upload
# -----------------------------------------------------------------------------

# Single Primary Cloudinary Account Setup (Default - ~25GB Free Storage)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=instangalog_videos

# -----------------------------------------------------------------------------
# 5 Cloudinary Accounts Pool Setup (5 x 25GB = ~125GB Total Free Storage)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME_1=your-cloudinary-cloud-name-1
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET_1=instangalog_videos

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME_2=your-cloudinary-cloud-name-2
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET_2=instangalog_videos

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME_3=your-cloudinary-cloud-name-3
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET_3=instangalog_videos

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME_4=your-cloudinary-cloud-name-4
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET_4=instangalog_videos

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME_5=your-cloudinary-cloud-name-5
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET_5=instangalog_videos
